# Required at build AND runtime. Use your SCMS project values in Hostinger.
NEXT_PUBLIC_SUPABASE_URL=https://your-scms-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-scms-publishable-key

# Optional server-side KarateTech integration; preserve your current values.
KARATETECH_API_URL=https://karatetech3.spsportdatasolution.org
KARATETECH_API_KEY=
KARATETECH_API_TIMEOUT_MS=15000
# Legacy client integration endpoint, if used (never put a secret here).
NEXT_PUBLIC_KARATETECH_API_URL=
